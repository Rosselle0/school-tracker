rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleOwner(sub) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.firebase.identities["google.com"][0] == sub;
    }

    match /users/{sub} {
      allow read: if isGoogleOwner(sub);
      allow create, update: if isGoogleOwner(sub) && request.resource.data.sub == sub;
      allow delete: if isGoogleOwner(sub);
    }
  }
}
